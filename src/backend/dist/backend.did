type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type ServerStatus = record {online: bool;};
type Result__1 = 
 variant {
   err: Error;
   ok;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type PipelineStatus = 
 record {
   encoder: PipelineState;
   nlpParser: PipelineState;
   scriptGenerator: PipelineState;
 };
type PipelineState = 
 variant {
   completed;
   idle;
   processing;
 };
type PipelineStage = 
 variant {
   encoder;
   nlpParser;
   scriptGenerator;
 };
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
service : {
  __accessControlState: () -> (reserved) query;
  __pipelineStates: () -> (reserved) query;
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__1);
  _internet_identity_sign_in_start: () -> (blob);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  execute: (qJson: text) -> (Result) query;
  getCallerUserRole: () -> (UserRole) query;
  getPipelineStatus: (testRequestId: text) -> (PipelineStatus) query;
  getServerStatus: () -> (ServerStatus) query;
  isCallerAdmin: () -> (bool) query;
  runPipeline: (testRequestId: text) -> (PipelineStatus);
  schema: () -> (text) query;
  updatePipelineStatus: (testRequestId: text, stage: PipelineStage, state:
   PipelineState) -> (PipelineState);
}
